<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="1.5dp" android:color="#1e293b" />
            <corners android:radius="16dp" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Top Icon Badge -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:top="10dp"
        android:left="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="14dp"
        android:height="14dp"
        android:top="15dp"
        android:left="15dp"
        android:drawable="@drawable/ic_food" />

    <!-- Center Menu Pill -->
    <item
        android:top="40dp"
        android:bottom="52dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e3a8a" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- White Badges Row Placeholder -->
    <item
        android:height="12dp"
        android:bottom="34dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Status Badge -->
    <item
        android:height="14dp"
        android:bottom="14dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#059669" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>

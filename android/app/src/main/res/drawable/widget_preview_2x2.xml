<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="1.5dp" android:color="#1e293b" />
            <corners android:radius="16dp" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Top Icon Badge -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:top="10dp"
        android:left="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <item
        android:width="16dp"
        android:height="16dp"
        android:top="15dp"
        android:left="15dp"
        android:drawable="@drawable/ic_food" />

    <!-- Center Menu Pill -->
    <item
        android:top="44dp"
        android:bottom="38dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e3a8a" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Bottom Badges Placeholder -->
    <item
        android:height="14dp"
        android:bottom="16dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#059669" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>

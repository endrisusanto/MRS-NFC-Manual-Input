<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="1.5dp" android:color="#1e293b" />
            <corners android:radius="16dp" />
            <size android:width="250dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Top Left Icon Box -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:top="10dp"
        android:left="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="16dp"
        android:height="16dp"
        android:top="15dp"
        android:left="17dp"
        android:drawable="@drawable/ic_food" />

    <!-- Top Right Nav Buttons (Prev & Next Arrows) -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:top="13dp"
        android:right="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:top="17dp"
        android:right="40dp"
        android:drawable="@drawable/ic_prev" />

    <item
        android:width="20dp"
        android:height="20dp"
        android:top="13dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:top="17dp"
        android:right="16dp"
        android:drawable="@drawable/ic_next" />

    <!-- Center Menu Text Line -->
    <item
        android:top="44dp"
        android:bottom="46dp"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e3a8a" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- 3 Group Badges Row -->
    <item
        android:height="16dp"
        android:bottom="26dp"
        android:left="12dp"
        android:right="172dp">
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFC" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:height="16dp"
        android:bottom="26dp"
        android:left="92dp"
        android:right="92dp">
        <shape android:shape="rectangle">
            <solid android:color="#047857" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:height="16dp"
        android:bottom="26dp"
        android:left="172dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#334155" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Status Badge (Bottom Fullwidth) -->
    <item
        android:height="14dp"
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#F87171" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>

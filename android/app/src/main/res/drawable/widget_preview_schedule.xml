<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="1.5dp" android:color="#1e293b" />
            <corners android:radius="16dp" />
            <size android:width="250dp" android:height="150dp" />
        </shape>
    </item>

    <!-- Top Icon Badge -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:top="10dp"
        android:left="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="14dp"
        android:height="14dp"
        android:top="15dp"
        android:left="17dp"
        android:drawable="@drawable/ic_food" />

    <!-- Card 1: Hari Ini -->
    <item
        android:top="38dp"
        android:bottom="60dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Card 2: Besok -->
    <item
        android:top="96dp"
        android:bottom="10dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>

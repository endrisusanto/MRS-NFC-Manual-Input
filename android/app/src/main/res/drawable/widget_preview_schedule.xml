<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="1.5dp" android:color="#1e293b" />
            <corners android:radius="16dp" />
            <size android:width="250dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Top Left Icon Box -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:top="10dp"
        android:left="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="16dp"
        android:height="16dp"
        android:top="15dp"
        android:left="17dp"
        android:drawable="@drawable/ic_food" />

    <!-- Top Center Slide Counter Badge (1/3) -->
    <item
        android:width="28dp"
        android:height="16dp"
        android:top="15dp"
        android:right="46dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Top Right Refresh Button -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:top="10dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="16dp"
        android:height="16dp"
        android:top="15dp"
        android:right="17dp"
        android:drawable="@drawable/ic_refresh" />

    <!-- Middle Menu Row with Circle Arrows on Left & Right -->
    <!-- Left Circle Arrow -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:top="44dp"
        android:left="12dp">
        <shape android:shape="oval">
            <solid android:color="#1e293b" />
            <stroke android:width="1dp" android:color="#334155" />
        </shape>
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:top="50dp"
        android:left="18dp"
        android:drawable="@drawable/ic_prev" />

    <!-- Center Menu Text Line -->
    <item
        android:top="48dp"
        android:bottom="56dp"
        android:left="42dp"
        android:right="42dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e3a8a" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Right Circle Arrow -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:top="44dp"
        android:right="12dp">
        <shape android:shape="oval">
            <solid android:color="#1e293b" />
            <stroke android:width="1dp" android:color="#334155" />
        </shape>
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:top="50dp"
        android:right="18dp"
        android:drawable="@drawable/ic_next" />

    <!-- Full-Width 3 Bento Badges Row -->
    <item
        android:height="16dp"
        android:bottom="26dp"
        android:left="12dp"
        android:right="172dp">
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFC" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:height="16dp"
        android:bottom="26dp"
        android:left="92dp"
        android:right="92dp">
        <shape android:shape="rectangle">
            <solid android:color="#047857" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:height="16dp"
        android:bottom="26dp"
        android:left="172dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#334155" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Full-Width Status Badge -->
    <item
        android:height="14dp"
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#F87171" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>

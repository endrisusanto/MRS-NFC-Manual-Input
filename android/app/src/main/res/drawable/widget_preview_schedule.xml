<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
            <stroke android:width="1.5dp" android:color="#1e293b" />
            <corners android:radius="16dp" />
            <size android:width="250dp" android:height="120dp" />
        </shape>
    </item>

    <!-- Top Left Icon Box -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:top="10dp"
        android:left="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="16dp"
        android:height="16dp"
        android:top="15dp"
        android:left="17dp"
        android:drawable="@drawable/ic_food" />

    <!-- Top Right Refresh Button -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:top="10dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="16dp"
        android:height="16dp"
        android:top="15dp"
        android:right="17dp"
        android:drawable="@drawable/ic_refresh" />

    <!-- Left Side Arrow Button -->
    <item
        android:width="22dp"
        android:height="52dp"
        android:top="44dp"
        android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="14dp"
        android:height="14dp"
        android:top="63dp"
        android:left="12dp"
        android:drawable="@drawable/ic_prev" />

    <!-- Right Side Arrow Button -->
    <item
        android:width="22dp"
        android:height="52dp"
        android:top="44dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e293b" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item
        android:width="14dp"
        android:height="14dp"
        android:top="63dp"
        android:right="12dp"
        android:drawable="@drawable/ic_next" />

    <!-- Center Menu Text Line -->
    <item
        android:top="42dp"
        android:bottom="48dp"
        android:left="38dp"
        android:right="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#1e3a8a" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- 3 Badges Row -->
    <item
        android:height="14dp"
        android:bottom="26dp"
        android:left="38dp"
        android:right="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFC" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:height="14dp"
        android:bottom="26dp"
        android:left="108dp"
        android:right="108dp">
        <shape android:shape="rectangle">
            <solid android:color="#047857" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:height="14dp"
        android:bottom="26dp"
        android:left="150dp"
        android:right="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#334155" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Status Badge (Bottom) -->
    <item
        android:height="14dp"
        android:bottom="8dp"
        android:left="38dp"
        android:right="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#F87171" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
